# ==============================================================================
# QuizMaster Environment Configuration
# Copy this file to .env or set these environment variables in your deployment.
# ==============================================================================

# ------------------------------------------------------------------------------
# Server & Runtime Configuration
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=development

# ------------------------------------------------------------------------------
# Database Configuration
# ------------------------------------------------------------------------------
# MongoDB connection string.
# In local development, if MongoDB is not reachable, an in-memory database
# (MongoMemoryServer) will automatically start and seed initial demo accounts.
MONGODB_URI=mongodb://127.0.0.1:27017/quizmaster

# ------------------------------------------------------------------------------
# Security & Authentication (JWT & Cookies)
# ------------------------------------------------------------------------------
# Secret key used for signing session tokens (must be at least 32 characters)
JWT_SECRET=quizmaster_super_secure_jwt_token_secret_key_2026_at_least_32_chars

# Session lifetime in hours (default: 8 hours)
JWT_EXPIRES_HOURS=8

# Allowed client origin for CORS and cookie handling (comma-separated for multiples)
CLIENT_URL=http://localhost:3000

# SameSite cookie attribute ('lax', 'strict', or 'none')
COOKIE_SAMESITE=lax

# Optional cookie domain for cross-subdomain authentication
# COOKIE_DOMAIN=example.com

# Number of reverse proxy hops to trust (1 for most PaaS like Render, Cloud Run)
TRUST_PROXY=1

# Password hashing cost factor (10 for fast testing, 12 for high security)
BCRYPT_ROUNDS=10

# ------------------------------------------------------------------------------
# Competition & Quiz Security Rules
# ------------------------------------------------------------------------------
# Grace period in seconds to accept submissions after the countdown timer reaches zero
SUBMIT_GRACE_SECONDS=5

# Maximum failed login attempts before temporary account lockout
MAX_LOGIN_ATTEMPTS=5

# Lockout duration in minutes after exceeding max failed attempts
LOCKOUT_MINUTES=15

# ------------------------------------------------------------------------------
# Initial Setup & Seeding (Optional)
# ------------------------------------------------------------------------------
# Default admin account created automatically on first start:
# Username: admin
# Password: AdminPassword123!
ADMIN_USERNAME=admin
ADMIN_PASSWORD=AdminPassword123!
ALLOW_SEED=true

# ------------------------------------------------------------------------------
# Client (Vite Frontend)
# ------------------------------------------------------------------------------
# API URL prefix for client fetch calls (leave as /api for same-origin proxy/serving)
VITE_API_URL=/api
VITE_DEV_API=http://localhost:3000