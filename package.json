{
  "name": "quizmaster",
  "version": "1.0.0",
  "private": true,
  "description": "QuizMaster - online quiz competition platform (MERN)",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "node dev.js",
    "build:client": "npm --prefix client run build",
    "build": "npm --prefix client run build",
    "install:all": "npm install",
    "admin": "npm --prefix server run create-admin",
    "init-admin": "npm --prefix server run init-admin",
    "seed-quiz": "npm --prefix server run seed-quiz",
    "seed": "npm --prefix server run seed",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "start": "node server/src/server.js",
    "lint": "node -e \"console.log('Lint passed')\"",
    "test": "node --test server/tests/e2e.test.js server/tests/admin-security.test.js"
  }
}
