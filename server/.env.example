# ==============================================================================
# QuizMaster Server Environment Configuration
# Copy this file to .env or set these environment variables in your deployment.
# ==============================================================================

PORT=3000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/quizmaster
JWT_SECRET=quizmaster_super_secure_jwt_token_secret_key_2026_at_least_32_chars
JWT_EXPIRES_HOURS=8
CLIENT_URL=http://localhost:3000
COOKIE_SAMESITE=lax
TRUST_PROXY=1
BCRYPT_ROUNDS=10
SUBMIT_GRACE_SECONDS=5
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
ADMIN_USERNAME=admin
ADMIN_PASSWORD=AdminPassword123!
ALLOW_SEED=true
